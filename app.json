{
  "expo": {
    "name": "IdeoHub",
    "slug": "IdeoHub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/IdeoHubnew.png",
    "scheme": "IdeoHub",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/IdeoHubnew.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/IdeoHubnew.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/IdeoHubnew.png",
          "imageWidth": 200,
          "imageHeight": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "preventAutoHide": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/IdeoHubnew.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
