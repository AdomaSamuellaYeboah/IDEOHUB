{
  "expo": {
    "name": "IdeoHub",
    "slug": "IdeoHub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/IdeoHublogo.png",
    "scheme": "IdeoHub",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/IdeoHublogo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.akboafo.IdeoHub"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/IdeoHublogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/IdeoHublogo.png",
          "imageWidth": 200,
          "imageHeight": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fffffff",
          "preventAutoHide": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/IdeoHublogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "687a60c1-6f92-4f71-94e2-a38b47664c1c"
      }
    }
  }
}
